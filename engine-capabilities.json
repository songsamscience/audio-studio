  "filters": {
    "atrim": true,
    "asetpts": true,
    "aresample": true,
    "aformat": true,
    "volume": true,
    "concat": true,
    "acrossfade": true,
    "asplit": true,
    "aloop": true,
    "apad": true,
    "adelay": true,
    "afade": true,
    "amix": true,
    "sidechaincompress": true,
    "afftdn": true,
    "highpass": true,
    "equalizer": true,
    "acompressor": true,
    "loudnorm": true,
    "alimiter": true,
    "asetrate": true,
    "atempo": true,
    "volumedetect": true,
    "pan": true,
    "areverse": true,
    "showwaves": true,
    "overlay": true,
    "format": true
