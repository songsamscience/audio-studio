      "monoOnly": true
    },
    "webm": {
      "encoder": "libopus",
      "codec": "opus",
      "mime": "audio/webm",
      "extension": "webm",
      "muxer": "webm",
      "kind": "lossy",
      "supported": true,
      "note": "이 엔진의 스테레오 Opus 인코딩은 소리에 따라 멈추는 문제가 있어 Opus는 모노로만 저장합니다. 스테레오가 필요하면 OGG(Vorbis)나 M4A를 쓰세요.",
      "monoOnly": true
    },
    "wma": {
      "encoder": "wmav2",
