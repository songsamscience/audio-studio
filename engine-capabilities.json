  "pitchMethod": "asetrate + atempo",
  "normalizeTargetLUFS": -16,
  "normalizeTruePeakDB": -1.5,
  "normalizeMaxGainDB": 18,
  "videoSizes": [
    "1280x720",
    "1920x1080",
    "1080x1080",
    "1080x1920"
  ],
  "videoStyles": [
    "cover",
    "waves"
  ],
  "unavailable": {
    "amr": "libopencore-amr가 코어에 없음",
    "gsm": "libgsm이 코어에 없음",
    "drawtext": "글꼴 파일(TTF)이 없어 사용하지 않음 · 영상 글자는 브라우저 캔버스로 그림",
    "opusStereo": "libopus 스테레오는 압축 수준 0에서도 잡음이 많은 소리·WebM·60 ms 프레임에서 wasm 메모리 오류(tests/engine-caps.html#set4) → 모노만 제공"
  }
